#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/Alvik.proto"
WorldInfo { title "Alvik | Sensor Motion" basicTimeStep 20 randomSeed 42
 contactProperties [
  ContactProperties { material1 "alvik tyre" material2 "default" coulombFriction [ 1 ] bumpSound "" rollSound "" slideSound "" }
  ContactProperties { material1 "alvik caster" material2 "default" coulombFriction [ 0.001 ] bumpSound "" rollSound "" slideSound "" }
 ]
}
DEF TOF_VIEWPOINT Viewpoint { orientation 0 1 0 1.5707963267948966 position 0 0 3.7 }
Background { skyColor [ .90 .93 .96 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 ambientIntensity .5 }
Solid { name "floor" locked TRUE children [ Shape {
 appearance Appearance { texture ImageTexture { url [ "textures/sensor_motion.png" ] filtering 0 } }
 geometry IndexedFaceSet { coord Coordinate { point [ -1.4 -1.4 0, 1.4 -1.4 0, -1.4 1.4 0, 1.4 1.4 0 ] }
 texCoord TextureCoordinate { point [ 0 0, 1 0, 0 1, 1 1 ] } coordIndex [ 2 0 1 3 -1 ] texCoordIndex [ 2 0 1 3 -1 ] }
 } ] boundingObject Plane { size 2.8 2.8 }
}


# Selecting a lab task places the box in its starting position.
DEF LAB_BOX Solid {
  translation -.18 .45 .065
  name "LAB_BOX - move for tasks 2 and 4"
  children [
    Shape {
      appearance PBRAppearance { baseColor .78 .32 .11 roughness 1 metalness 0 }
      geometry DEF LAB_BOX_GEOM Box { size .08 .08 .13 }
    }
  ]
  boundingObject USE LAB_BOX_GEOM
}

DEF ALVIK Alvik {
  translation -.55 0 .001
  supervisor TRUE
  controllerArgs [ "sensor_motion.py" "--beams" "--lab" ]
}
