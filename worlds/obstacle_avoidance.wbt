#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/Alvik.proto"
WorldInfo { title "Alvik | Obstacle Avoidance" basicTimeStep 10 randomSeed 42
 contactProperties [
  ContactProperties { material1 "alvik tyre" material2 "default" coulombFriction [ 1 ] bumpSound "" rollSound "" slideSound "" }
  ContactProperties { material1 "alvik caster" material2 "default" coulombFriction [ 0.001 ] bumpSound "" rollSound "" slideSound "" }
 ]
}
DEF TOF_VIEWPOINT Viewpoint { orientation 0.258033255 0.707002809 -0.658457187 1.012242207 position -0.95 0.8 1.15 }
Background { skyColor [ 0.88 0.91 0.95 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 ambientIntensity 0.5 }
Solid { name "floor" children [ Shape {
 appearance PBRAppearance { baseColorMap ImageTexture { url [ "textures/obstacle_avoidance.png" ] filtering 0 } roughness 0.8 metalness 0 }
 geometry IndexedFaceSet { coord Coordinate { point [ -.9 -.9 0, .9 -.9 0, -.9 .9 0, .9 .9 0 ] }
 texCoord TextureCoordinate { point [ 0 0, 1 0, 0 1, 1 1 ] } coordIndex [ 2 0 1 3 -1 ] texCoordIndex [ 2 0 1 3 -1 ] }
 } ] boundingObject Plane { size 1.8 1.8 } locked TRUE
}
DEF OBSTACLE Solid {
 translation -0.10 0 0.03
 name "move this obstacle to experiment"
 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.48 0.35 roughness 0.7 metalness 0 } geometry Box { size 0.06 0.05 0.06 } } ]
 boundingObject Box { size 0.06 0.05 0.06 }
 locked TRUE
}
DEF ALVIK Alvik { translation -0.65 0 0.001 controller "arduino_alvik" controllerArgs [ "obstacle_avoidance.py" "--beams" ] supervisor TRUE }
