#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/Alvik.proto"
WorldInfo { title "Alvik | Robot Playground" basicTimeStep 20 randomSeed 42
 contactProperties [
  ContactProperties { material1 "alvik tyre" material2 "default" coulombFriction [ 1 ] bumpSound "" rollSound "" slideSound "" }
  ContactProperties { material1 "alvik caster" material2 "default" coulombFriction [ 0.001 ] bumpSound "" rollSound "" slideSound "" }
 ]
}
Viewpoint { orientation -0.577350269 0.577350269 0.577350269 2.094395102 position 0 0 3.4 }
Background { skyColor [ .90 .93 .96 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 ambientIntensity .5 }
Solid { name "floor" locked TRUE children [ Shape {
 appearance Appearance { texture ImageTexture { url [ "textures/playground.png" ] filtering 0 } }
 geometry IndexedFaceSet { coord Coordinate { point [ -1.4 -1.4 0, 1.4 -1.4 0, -1.4 1.4 0, 1.4 1.4 0 ] }
 texCoord TextureCoordinate { point [ 0 0, 1 0, 0 1, 1 1 ] } coordIndex [ 2 0 1 3 -1 ] texCoordIndex [ 2 0 1 3 -1 ] }
 } ] boundingObject Plane { size 2.8 2.8 }
}


# The tinted floor marks the prop bay outside the enclosed driving arena.
Pose {
  translation .97 .10 .0005
  children [
    Shape {
      appearance PBRAppearance { baseColor .63 .72 .83 roughness 1 metalness 0 }
      geometry Plane { size .60 1.40 }
    }
  ]
}

# Four fixed walls keep autonomous exploration inside the arena.
DEF ARENA_NORTH Solid {
  translation -.40 1.00 .09
  name "Arena north wall"
  locked TRUE
  children [ Shape {
    appearance DEF ARENA_MATERIAL PBRAppearance { baseColor .38 .44 .52 roughness 1 metalness 0 }
    geometry DEF ARENA_HORIZONTAL Box { size 1.84 .04 .18 }
  } ]
  boundingObject USE ARENA_HORIZONTAL
}
DEF ARENA_SOUTH Solid {
  translation -.40 -1.00 .09
  name "Arena south wall"
  locked TRUE
  children [ Shape { appearance USE ARENA_MATERIAL geometry USE ARENA_HORIZONTAL } ]
  boundingObject USE ARENA_HORIZONTAL
}
DEF ARENA_WEST Solid {
  translation -1.30 0 .09
  name "Arena west wall"
  locked TRUE
  children [ Shape {
    appearance USE ARENA_MATERIAL
    geometry DEF ARENA_VERTICAL Box { size .04 1.96 .18 }
  } ]
  boundingObject USE ARENA_VERTICAL
}
DEF ARENA_EAST Solid {
  translation .50 0 .09
  name "Arena east wall"
  locked TRUE
  children [ Shape { appearance USE ARENA_MATERIAL geometry USE ARENA_VERTICAL } ]
  boundingObject USE ARENA_VERTICAL
}

# One starter obstacle demonstrates avoidance without filling the arena.
DEF CENTER_BOX Solid {
  translation -.40 0 .08
  name "Starter obstacle | drag to reposition"
  children [ Shape {
    appearance PBRAppearance { baseColor .99 .45 .14 roughness .72 metalness 0 }
    geometry DEF CENTER_BOX_SHAPE Box { size .18 .18 .16 }
  } ]
  boundingObject USE CENTER_BOX_SHAPE
}

DEF PROP_BOX Solid {
  translation .80 .55 .05
  name "Prop box | move into path"
  children [
    Shape {
      appearance PBRAppearance { baseColor .99 .45 .14 roughness .72 metalness 0 }
      geometry DEF PROP_BOX_SHAPE Box { size .12 .12 .10 }
    }
  ]
  boundingObject USE PROP_BOX_SHAPE
}


DEF PROP_COLUMN Solid {
  translation 1.12 .55 .06
  name "Prop cylinder"
  children [
    Shape {
      appearance PBRAppearance { baseColor .11 .65 .79 roughness .72 metalness 0 }
      geometry DEF PROP_COLUMN_SHAPE Cylinder { radius .068 height .12 }
    }
  ]
  boundingObject USE PROP_COLUMN_SHAPE
}


DEF PROP_WALL Solid {
  translation .80 .15 .045
  name "Prop wall"
  children [
    Shape {
      appearance PBRAppearance { baseColor .21 .37 .69 roughness .72 metalness 0 }
      geometry DEF PROP_WALL_SHAPE Box { size .11 .26 .09 }
    }
  ]
  boundingObject USE PROP_WALL_SHAPE
}


DEF PROP_BLOCK Solid {
  translation 1.12 .15 .018
  name "Prop low block"
  children [
    Shape {
      appearance PBRAppearance { baseColor .83 .53 .12 roughness .72 metalness 0 }
      geometry DEF PROP_BLOCK_SHAPE Box { size .14 .14 .036 }
    }
  ]
  boundingObject USE PROP_BLOCK_SHAPE
}


DEF PROP_BALL Solid {
  translation 1.10 -.35 .059
  name "Prop rolling ball"
  children [
    Shape {
      appearance PBRAppearance { baseColor .69 .22 .54 roughness .72 metalness 0 }
      geometry DEF PROP_BALL_SHAPE Sphere { radius .059 }
    }
  ]
  boundingObject USE PROP_BALL_SHAPE
  physics Physics { density -1 mass 0.12 }
}


DEF ALVIK Alvik { supervisor TRUE
  translation -1.05 0 .001
  controllerArgs [ "playground.py" ]
}
DEF SCENE_TOOLS Robot {
  name "Playground tools"
  supervisor TRUE
  controller "arduino_alvik"
  controllerArgs [ "--playground-tools" ]
}
